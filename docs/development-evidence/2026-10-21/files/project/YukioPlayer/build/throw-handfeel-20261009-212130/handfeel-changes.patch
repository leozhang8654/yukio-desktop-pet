+        checks["slowReleasePlacesWithoutFlight"] = throwPlayback == nil && releasedAt != nil
+        finishHang()
+        checks["placementPreservesPosition"] = panel.frame == placed
+            && abs(defaults.double(forKey: "originY") - placed.minY) < 0.01
+
+        moveToMiddle(); dragBegan(); dragEnded(ThrowVector(900, 300))
+        checks["flickLaunches"] = throwPlayback != nil && swing == nil
+        checks["taskHiddenOnlyDuringFlight"] = !bubble.isVisible
+        questionPanel.cardView.answerText = "unsent draft"
+        task("Latest task after throwing")
+        for _ in 0..<2000 {
+            guard let flight = throwPlayback, flight.physics.phase != .normal else { break }
+            flight.physics.advance(1.0 / 120)
+        }
+        checks["flightCompletes"] = throwPlayback?.physics.phase == .normal
+        finishThrow()
+        checks["latestTaskWindowReturns"] = bubble.isVisible && bubble.parent === panel
+            && bubbleHold.value == router.statusLine(now: nowMs()) && bubbleHold.value != nil
+        checks["answerDraftSurvives"] = questionPanel.cardView.answerText == "unsent draft"
+
+        for phase in [ThrowPhysics.Phase.airborne, .dizzy, .recover] {
+            moveToMiddle(); dragBegan(); dragEnded(ThrowVector(950, 0))
+            for _ in 0..<2000 {
+                guard let flight = throwPlayback, flight.physics.phase != phase else { break }
+                flight.physics.advance(1.0 / 120)
+            }
+            checks["reached_" + phase.rawValue] = throwPlayback?.physics.phase == phase
+            render()
+            let session = throwSessionID
+            let caught = view.onCatch?() ?? false
+            checks["catchTransfersToHeld_" + phase.rawValue] = caught && throwPlayback == nil
+                && throwTimer == nil && swing != nil && heldTimeline != nil && releasedAt == nil
+            let time = nowMs()
+            swing?.advance(to: time + 33, handX: 100, handY: 100)
+            swing?.advance(to: time + 66, handX: 200, handY: 140)
+            checks["heldContinuesAnimating_" + phase.rawValue] = abs(swing?.rate ?? 0) > 0
+            dragEnded(.zero)
+            let resting = normalFrame()
+            finishHang()
+            checks["caughtPetCanBePlaced_" + phase.rawValue] = throwPlayback == nil && swing == nil
+                && throwTimer == nil && panel.frame == resting && bubble.isVisible
+            dragBegan(); dragEnded(ThrowVector(-1000, 0))
+            checks["caughtPetCanBeThrownAgain_" + phase.rawValue] = throwPlayback != nil
+                && throwSessionID == session + 1 && throwPlayback?.caught == false
+            _ = view.onCatch?()
+            view.onDragCancelled?()
+            checks["cancelClearsInteraction_" + phase.rawValue] = throwPlayback == nil && swing == nil && throwTimer == nil
+        }
+        dragBegan(); dragEnded(ThrowVector(900, 0))
+        setHidden(true); setHidden(false)
+        checks["taskReturnsAfterHidingDuringFlight"] = bubble.isVisible && bubbleHold.value != nil
+            && throwPlayback == nil && throwTimer == nil
+        return checks
+    }
+}
