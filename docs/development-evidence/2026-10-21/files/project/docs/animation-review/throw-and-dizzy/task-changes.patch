+        guard let spec=catalog.specs[id] else { return (AnimationCatalog.heldID,0) }
+        var timeline=SpriteTimeline(spec:spec,now:0); timeline.advance(to:max(0,seconds)*1000)
+        return (id,timeline.frame)
+    }
