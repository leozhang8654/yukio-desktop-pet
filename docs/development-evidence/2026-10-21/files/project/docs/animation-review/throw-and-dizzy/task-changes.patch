+        l,b,r,t=self.bounds()
+        point=((self.x+l,self.y),(self.x+r,self.y),(self.x,self.y+b),(self.x,self.y+t))[i]
+        self.event_count+=1
+        event=Impact(self.event_count,at,normal,point,speed,strength(self.c,speed))
+        self.events.append(event); self.last_impact=event
