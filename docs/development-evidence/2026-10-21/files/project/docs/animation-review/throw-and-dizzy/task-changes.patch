+        if self.y >= h-t-1e-6: self.vy=min(0,self.vy)
+
+    def _angle_at(self,t):
+        return max(-self.c['maxAngle'],min(self.c['maxAngle'],self.angle+self.rate*(1-math.exp(-4*t))/4))
+
+    def _gaps(self,t):
