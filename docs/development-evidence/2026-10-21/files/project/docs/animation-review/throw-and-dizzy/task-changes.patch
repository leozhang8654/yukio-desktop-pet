+        b=self.bounds(); w,h=self.room
+        ratio=min(1,(w-2)/max(b[2]-b[0],1),(h-2)/max(b[3]-b[1],1))
+        if ratio < 1:
+            self.scale *= max(0.001,ratio); self.degraded=True
+
+    def _recover_inside(self):
+        l,b,r,t=self.bounds(); w,h=self.room
