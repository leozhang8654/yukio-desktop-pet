+        let correctionX=max(room.minX-origin.x-minX,min(0,room.maxX-origin.x-maxX))
+        let correctionY=physics.ground ? room.minY-origin.y-minY : max(room.minY-origin.y-minY,min(0,room.maxY-origin.y-maxY))
